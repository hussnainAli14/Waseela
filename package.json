{
  "name": "Waseela",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "android-clean": "cd android && ./gradlew clean",
    "ios-pods": "cd ios && pod install",
    "android-build": "cd android && ./gradlew assembleRelease",
    "android-bundle": "cd android && ./gradlew bundleRelease",
    "reinstall-modules": "rm -rf node_modules && npm i",
    "reinstall-pods": "cd ios && rm -rf Podfile.lock Pods build && pod deintegrate && rm -rf ~/Library/Developer/Xcode/DerivedData/* && pod --repo-update install",
    "reset-start": "react-native start --reset-cache",
    "generate-key": "cd android && ./gradlew signingReport"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-documents/picker": "^12.0.0",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/auth": "^23.7.0",
    "@react-native-firebase/firestore": "^23.7.0",
    "@react-native-firebase/storage": "^23.7.0",
    "@react-native/new-app-screen": "0.82.1",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/native-stack": "^7.8.5",
    "@reduxjs/toolkit": "^2.11.2",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-image-picker": "^8.1.3",
    "react-native-image-resizer": "^1.4.5",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.18.0",
    "react-native-vector-icons": "^10.2.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
